{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/page.js": { "includeFiles": "private/wiki.html" }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/api/page" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] }
  ]
}
